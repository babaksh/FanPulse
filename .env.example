# FanPulse Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================================================
# IBM watsonx.ai (Granite) - Required for IBM Challenge
# ============================================================================
# Get your API key from: https://cloud.ibm.com/iam/apikeys
# Get your project ID from: https://dataplatform.cloud.ibm.com/
IBM_WATSONX_API_KEY=your_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================================================
# OpenAI - For quick testing
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================================================
# HuggingFace - Free alternative
# ============================================================================
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# ============================================================================
# Anthropic Claude - Optional
# ============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# Google Gemini - Optional
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# Application Settings
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO