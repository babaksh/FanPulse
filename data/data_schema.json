{
  "_agent_reading_guide": {
    "purpose": "Canonical schema reference for FanPulse football data - READ THIS BEFORE ANY QUERY",
    "core_rules": [
      "Before any query, filter, or calculation, read this schema to understand data structure and availability",
      "results.csv covers ALL international matches (1872-2026, ~45,000 matches) - use for historical analysis",
      "tactical_stats.csv covers ONLY major tournaments (WC2022_*, WC2026_*) - use for tactical details",
      "Check match_id prefix to determine tactical data availability (WC2022_* or WC2026_* = available)",
      "Use query_csv tool for custom queries outside the 4 specialized tools",
      "Never fabricate data - if tactical stats unavailable, acknowledge limitation clearly"
    ],
    "decision_tree": {
      "historical_records": "Use results.csv",
      "tactical_details": "Check prefix → WC2022_*/WC2026_* → Use tactical_stats.csv, else results.csv only",
      "custom_query": "Use query_csv tool with appropriate table"
    }
  },
  
  "results.csv": {
    "path": "data/match_data/results.csv",
    "primary_date_column": "date",
    "grain": "One row per international match",
    "table_role": "Primary source for all historical match results and team performance analysis",
    "coverage": {
      "time_range": "1872-2026 (154 years)",
      "total_matches": "~45,000 international matches",
      "match_types": "ALL competitions (World Cups, Euros, Copa América, friendlies, qualifiers, etc.)",
      "update_frequency": "Daily (live matches added in real-time)"
    },
    "columns": {
      "date": {
        "type": "date",
        "format": "YYYY-MM-DD",
        "desc": "Match date",
        "example": "2022-12-18",
        "use_for": "Time-based filtering, recent form calculation, historical trends"
      },
      "home_team": {
        "type": "string",
        "desc": "Home team name",
        "example": "Argentina",
        "use_for": "Team filtering, head-to-head analysis"
      },
      "away_team": {
        "type": "string",
        "desc": "Away team name",
        "example": "France",
        "use_for": "Team filtering, head-to-head analysis"
      },
      "home_score": {
        "type": "integer",
        "desc": "Goals scored by home team",
        "example": "3",
        "use_for": "Goal statistics, win/loss determination, scoring trends"
      },
      "away_score": {
        "type": "integer",
        "desc": "Goals scored by away team",
        "example": "3",
        "use_for": "Goal statistics, win/loss determination, scoring trends"
      },
      "tournament": {
        "type": "string",
        "desc": "Competition name",
        "example": "FIFA World Cup",
        "use_for": "Tournament filtering, competition-specific analysis"
      },
      "city": {
        "type": "string",
        "desc": "Match venue city",
        "example": "Lusail",
        "use_for": "Venue analysis, geographic patterns"
      },
      "country": {
        "type": "string",
        "desc": "Host country",
        "example": "Qatar",
        "use_for": "Home advantage analysis, tournament host patterns"
      },
      "neutral": {
        "type": "boolean",
        "values": ["TRUE", "FALSE"],
        "desc": "Neutral venue flag",
        "example": "TRUE",
        "use_for": "Home advantage analysis, venue context"
      }
    },
    "use_cases": [
      "Historical head-to-head records (all time periods)",
      "Win rates and goal statistics",
      "Recent form calculation (last 5-10 matches)",
      "Tournament participation history",
      "Long-term performance trends"
    ],
    "limitations": [
      "NO tactical details (possession, shots, xG, passes)",
      "NO formations or tactical systems",
      "NO player-level data",
      "NO referee information",
      "NO venue capacity or attendance"
    ],
    "query_examples": {
      "team_all_matches": "Filter by home_team='Germany' OR away_team='Germany'",
      "recent_form": "Filter by date >= '2024-01-01' AND team",
      "head_to_head": "Filter by (home_team='A' AND away_team='B') OR (home_team='B' AND away_team='A')",
      "tournament_specific": "Filter by tournament='FIFA World Cup'"
    }
  },
  
