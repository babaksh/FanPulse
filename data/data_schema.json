  "common_mistakes_to_avoid": {
    "mistake_1": {
      "wrong": "Assuming tactical data exists for all matches",
      "right": "Check match_id prefix - only WC2022_* and WC2026_* have tactical data"
    },
    "mistake_2": {
      "wrong": "Confusing 'World Cup 2022' with 'all 2022 matches'",
      "right": "WC2022_* = only World Cup tournament matches, not friendlies or qualifiers in 2022"
    },
    "mistake_3": {
      "wrong": "Fabricating possession/xG when tactical_stats.csv doesn't have the match",
