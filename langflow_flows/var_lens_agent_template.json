{
  "name": "VAR-Lens Agent",
  "description": "AI agent for explaining VAR (Video Assistant Referee) decisions using FIFA/IFAB official documents",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "file_loader_1",
      "type": "DirectoryLoader",
      "position": {"x": 100, "y": 100},
      "data": {
        "path": "data/processed_documents",
        "glob": "**/*.md",
        "recursive": true,
        "loader_cls": "TextLoader",
        "loader_kwargs": {
          "encoding": "utf-8"
        }
      },
      "label": "Load FIFA Documents"
    },
    {
      "id": "text_splitter_1",
      "type": "RecursiveCharacterTextSplitter",
      "position": {"x": 300, "y": 100},
      "data": {
        "chunk_size": 1000,
        "chunk_overlap": 200,
        "separators": ["\n\n", "\n", " ", ""]
      },
      "label": "Split Documents"
    },
    {
      "id": "embeddings_1",
      "type": "HuggingFaceEmbeddings",
      "position": {"x": 300, "y": 250},
      "data": {
        "model_name": "sentence-transformers/all-MiniLM-L6-v2",
        "model_kwargs": {
          "device": "cpu"
        },
        "encode_kwargs": {
          "normalize_embeddings": true
        }
      },
      "label": "Create Embeddings"
    },
    {
      "id": "vector_store_1",
      "type": "FAISS",
      "position": {"x": 500, "y": 150},
      "data": {
        "index_name": "var_lens_index",
        "allow_dangerous_deserialization": true
      },
      "label": "Vector Store"
    },
    {
      "id": "chat_input_1",
      "type": "ChatInput",
      "position": {"x": 100, "y": 400},
      "data": {
        "input_value": "",
        "sender": "User",
        "sender_name": "User"
      },
      "label": "User Question"
    },
    {
      "id": "retriever_1",
      "type": "VectorStoreRetriever",
      "position": {"x": 500, "y": 300},
      "data": {
        "search_type": "similarity",
        "search_kwargs": {
          "k": 4,
          "score_threshold": 0.7
        }
      },
      "label": "Retrieve Documents"
    },
    {
      "id": "prompt_1",
      "type": "PromptTemplate",
      "position": {"x": 700, "y": 300},
      "data": {
        "template": "You are VAR-Lens, an expert AI assistant specialized in explaining VAR (Video Assistant Referee) decisions in football/soccer.\n\nYour role is to:\n1. Provide clear, accurate explanations based on official FIFA/IFAB rules\n2. Reference specific rules and protocols when explaining decisions\n3. Use simple language that fans can understand\n4. Be objective and educational\n\nContext from FIFA/IFAB Documents:\n{context}\n\nQuestion: {question}\n\nInstructions:\n- Answer based ONLY on the provided context\n- If the context doesn't contain enough information, say so clearly\n- Reference specific rule numbers or sections when applicable\n- Keep explanations concise but complete\n- Use bullet points for clarity when appropriate\n\nAnswer:",
        "input_variables": ["context", "question"]
      },
      "label": "VAR-Lens Prompt"
    },
    {
      "id": "llm_1",
      "type": "ChatOpenAI",
      "position": {"x": 900, "y": 300},
      "data": {
        "model_name": "gpt-3.5-turbo",
        "temperature": 0,
        "max_tokens": 500,
        "openai_api_key": "${OPENAI_API_KEY}"
      },
      "label": "LLM (OpenAI)"
    },
    {
      "id": "chat_output_1",
      "type": "ChatOutput",
      "position": {"x": 1100, "y": 300},
      "data": {
        "data_template": "{text}",
        "sender": "VAR-Lens",
        "sender_name": "VAR-Lens"
      },
      "label": "Answer"
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "source": "file_loader_1",
      "target": "text_splitter_1",
      "sourceHandle": "documents",
      "targetHandle": "documents"
    },
    {
      "id": "edge_2",
      "source": "text_splitter_1",
      "target": "vector_store_1",
      "sourceHandle": "chunks",
      "targetHandle": "documents"
    },
    {
      "id": "edge_3",
      "source": "embeddings_1",
      "target": "vector_store_1",
      "sourceHandle": "embeddings",
      "targetHandle": "embedding"
    },
    {
      "id": "edge_4",
      "source": "vector_store_1",
      "target": "retriever_1",
      "sourceHandle": "vector_store",
      "targetHandle": "vector_store"
    },
    {
      "id": "edge_5",
      "source": "chat_input_1",
      "target": "retriever_1",
      "sourceHandle": "message",
      "targetHandle": "query"
    },
    {
      "id": "edge_6",
      "source": "retriever_1",
      "target": "prompt_1",
      "sourceHandle": "documents",
      "targetHandle": "context"
    },
    {
      "id": "edge_7",
      "source": "chat_input_1",
      "target": "prompt_1",
      "sourceHandle": "message",
      "targetHandle": "question"
    },
    {
      "id": "edge_8",
      "source": "prompt_1",
      "target": "llm_1",
      "sourceHandle": "prompt",
      "targetHandle": "prompt"
    },
    {
      "id": "edge_9",
      "source": "llm_1",
      "target": "chat_output_1",
      "sourceHandle": "text",
      "targetHandle": "text"
    }
  ],
  "metadata": {
    "created_by": "FanPulse Team",
    "created_at": "2026-06-10",
    "purpose": "VAR decision explanation using RAG",
    "technologies": [
      "Langflow",
      "LangChain",
      "FAISS",
      "HuggingFace",
      "OpenAI"
    ],
    "documents_processed": 7,
    "total_document_size": "450 KB"
  }
}